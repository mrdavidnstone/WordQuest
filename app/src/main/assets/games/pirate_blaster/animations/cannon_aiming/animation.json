{
  "name": "pirate_blaster_cannon_aiming",
  "version": 1,
  "description": "15 pre-rendered cannon aiming sprites (center + left side). The right side is the left sprites mirrored in code (flip_x). Aim is selected by swapping whole sprites; sprites are never rotated, skewed, or stretched.",
  "sprite_dir": "sprites/",
  "canvas": {
    "width": 308,
    "height": 308,
    "note": "All 25 PNGs share this exact size (RGBA). Draw them all at the same scale."
  },
  "pivot_px": {
    "x": 154,
    "y": 298,
    "note": "Mount point, i.e. the centre of the cannon's base at the bottom edge. It is the same pixel in every sprite. Anchor this point to the cannon mount position on screen."
  },
  "yaw_steps": [
    "far_left",
    "mid_left",
    "center",
    "mid_right",
    "far_right"
  ],
  "pitch_steps": [
    "high",
    "upper_mid",
    "center",
    "lower_mid",
    "low"
  ],
  "grid_rows_are_pitch_cols_are_yaw": [
    [
      "far_left/high",
      "mid_left/high",
      "center/high",
      "mid_right/high",
      "far_right/high"
    ],
    [
      "far_left/upper_mid",
      "mid_left/upper_mid",
      "center/upper_mid",
      "mid_right/upper_mid",
      "far_right/upper_mid"
    ],
    [
      "far_left/center",
      "mid_left/center",
      "center/center",
      "mid_right/center",
      "far_right/center"
    ],
    [
      "far_left/lower_mid",
      "mid_left/lower_mid",
      "center/lower_mid",
      "mid_right/lower_mid",
      "far_right/lower_mid"
    ],
    [
      "far_left/low",
      "mid_left/low",
      "center/low",
      "mid_right/low",
      "far_right/low"
    ]
  ],
  "aim_space": {
    "aim_x": "-1 = far left of the play area, 0 = straight ahead, +1 = far right",
    "aim_y": "+1 = barrel raised highest, 0 = level, -1 = barrel lowered most",
    "yaw_bins": {
      "far_left": [
        -1.0,
        -0.75
      ],
      "mid_left": [
        -0.75,
        -0.25
      ],
      "center": [
        -0.25,
        0.25
      ],
      "mid_right": [
        0.25,
        0.75
      ],
      "far_right": [
        0.75,
        1.0
      ]
    },
    "pitch_bins": {
      "high": [
        0.75,
        1.0
      ],
      "upper_mid": [
        0.25,
        0.75
      ],
      "center": [
        -0.25,
        0.25
      ],
      "lower_mid": [
        -0.75,
        -0.25
      ],
      "low": [
        -1.0,
        -0.75
      ]
    },
    "formulas": {
      "yaw_index": "clamp(round(aim_x*2)+2, 0, 4)",
      "pitch_index": "clamp(2-round(aim_y*2), 0, 4)"
    },
    "hysteresis": 0.08,
    "hysteresis_note": "Only leave the current bin once aim has passed the bin edge by this much, so the sprite does not flicker at a boundary."
  },
  "target_to_aim": {
    "aim_x": "clamp((target_screen_x - pivot_screen_x) / yaw_full_scale_px, -1, 1)",
    "aim_y": "clamp((horizon_screen_y - target_screen_y) / pitch_full_scale_px, -1, 1)",
    "tunables": {
      "yaw_full_scale_px": "default: screen_width / 2",
      "horizon_screen_y": "screen Y of the horizon line",
      "pitch_full_scale_px": "default: distance from horizon to the bottom of the play area"
    }
  },
  "right_side": {
    "method": "runtime horizontal mirror of the matching left sprite (flip_x = true); no right-side files are shipped",
    "mapping": {
      "mid_right": "mirror of mid_left",
      "far_right": "mirror of far_left",
      "center": "shared, symmetric (no flip)"
    },
    "how": "Mirror around the pivot's x (the canvas centre column) so the base stays put. On Android Canvas: canvas.scale(-1f, 1f, mountX, mountY) before drawing, then restore.",
    "muzzle": "muzzle_px for flipped frames is already mirrored (canvas_width - x)."
  },
  "playback": {
    "swap_mode": "instant",
    "tween": "none",
    "min_ms_between_swaps": 0,
    "rules": [
      "Swap the whole sprite; never rotate, shear, or non-uniformly scale it to fake an angle. The ONLY allowed transform besides uniform scale is the horizontal mirror (flip_x) around the pivot x for the right side.",
      "Draw every sprite with the identical origin (pivot at the mount point) so nothing jumps, flipped or not.",
      "Pre-load all 25 bitmaps at start-up; never decode during gameplay.",
      "Draw order: ship deck, then cannon sprite, then projectiles/effects (spawn projectiles at muzzle_px)."
    ]
  },
  "muzzle_note": "muzzle_px is the barrel tip in canvas pixels, estimated from the artwork. Spawn cannonballs and flashes there (scaled and offset like the sprite). Verify visually and nudge per frame if needed.",
